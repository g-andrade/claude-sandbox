[Unit]
Description=nftables backstop for the claude-sandbox Docker networks
Before=docker.service
Wants=network-pre.target
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /etc/claude-sandbox/claude-sandbox.nft
ExecReload=/usr/bin/nft -f /etc/claude-sandbox/claude-sandbox.nft
ExecStop=/usr/bin/nft delete table inet claude_sandbox

[Install]
WantedBy=multi-user.target
